# Shared configuration for the MAG pipeline wrapper.
# Override any setting by either:
# 1. editing this file for your lab defaults, or
# 2. exporting the variable before running `./run_pipeline.sh`.

# Required input when running the full pipeline from raw paired-end reads.
RAW_READS_DIR="${RAW_READS_DIR:-raw_reads}"
RQC_LABELING_PATTERN_FWD="${RQC_LABELING_PATTERN_FWD:-_R1_001.fastq.gz}"
RQC_LABELING_PATTERN_REV="${RQC_LABELING_PATTERN_REV:-_R2_001.fastq.gz}"

# Optional input when skipping RQCFilter and starting from pre-filtered reads.
FILTERED_READS_DIR="${FILTERED_READS_DIR:-}"

# Default run directory. Override with `--run-dir` for per-run output roots.
RUN_ROOT="${RUN_ROOT:-$PWD/runs/default}"
PIPELINE_NAME="${PIPELINE_NAME:-metagenome_analysis}"

# Stage toggles.
RUN_RQCFILTER="${RUN_RQCFILTER:-true}"
RUN_ASSEMBLY="${RUN_ASSEMBLY:-true}"
RUN_MEGAHIT="${RUN_MEGAHIT:-true}"
RUN_BINNING="${RUN_BINNING:-true}"
RUN_DAS_TOOL="${RUN_DAS_TOOL:-true}"
RUN_BIN_ANALYSIS="${RUN_BIN_ANALYSIS:-true}"
RUN_DAS_BINS_QC="${RUN_DAS_BINS_QC:-true}"
RUN_GTDBTK="${RUN_GTDBTK:-false}"
RUN_REPORT="${RUN_REPORT:-true}"

# Common runtime settings.
CONDA="${CONDA:-/home/jduque2/miniforge3/bin/conda}"
MAX_PARALLEL="${MAX_PARALLEL:-1}"
THREADS="${THREADS:-${SLURM_CPUS_PER_TASK:-16}}"
SAMPLE_FILTER="${SAMPLE_FILTER:-}"

# Images and envs consumed by the underlying stage scripts.
BBTOOLS_IMAGE="${BBTOOLS_IMAGE:-bbtools_38.86.sif}"
BBTOOLS_LATEST_IMAGE="${BBTOOLS_LATEST_IMAGE:-bbtools_latest.sif}"
SPADES_IMAGE="${SPADES_IMAGE:-spades_3.15.2.sif}"
MEGAHIT_IMAGE="${MEGAHIT_IMAGE:-megahit.sif}"
METABAT2_IMAGE="${METABAT2_IMAGE:-metabat2.sif}"
MAXBIN2_ENV="${MAXBIN2_ENV:-maxbin2}"
CONCOCT_ENV="${CONCOCT_ENV:-concoct}"
DAS_TOOL_ENV="${DAS_TOOL_ENV:-das-tool}"
BUSCO_ENV="${BUSCO_ENV:-busco}"
GTDBTK_ENV="${GTDBTK_ENV:-gtdbtk-2.6.1}"

# Optional GTDB-Tk classify_wf arguments.
GTDBTK_EXTRA_ARGS="${GTDBTK_EXTRA_ARGS:-}"

# Optional preflight relaxation knobs for testing/debugging.
SKIP_PREFLIGHT_MODULES="${SKIP_PREFLIGHT_MODULES:-false}"
